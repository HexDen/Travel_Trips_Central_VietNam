# ===================================================
# CONCURRENT CRAWLER CONFIGURATION
# Platform Du Lịch Miền Trung (Đà Nẵng, Huế, Hội An, Quy Nhơn...)
# ===================================================

# --- PostgreSQL & PostGIS ---
# Đảm bảo PostgreSQL đã bật: CREATE EXTENSION IF NOT EXISTS postgis;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_central_vn
PG_SSL=false

# --- Redis (BullMQ Message Queue) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Anti-bot Rotating Proxies (Phân cách bởi dấu phẩy) ---
# Ví dụ: http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080
PROXIES=
